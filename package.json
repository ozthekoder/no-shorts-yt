{
  "name": "no-shorts",
  "version": "1.0.1",
  "private": true,
  "description": "Zen/Firefox extension that hides YouTube Shorts from feeds, search, sidebars and navigation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "web-ext lint",
    "test": "playwright test",
    "start": "web-ext run --firefox=/Applications/Zen.app/Contents/MacOS/zen --start-url https://www.youtube.com",
    "build": "web-ext build --overwrite-dest",
    "sign:unlisted": "web-ext sign --channel=unlisted",
    "sign:listed": "web-ext sign --channel=listed --amo-metadata=store/amo-metadata.json --approval-timeout=0",
    "survey": "node scripts/survey.mjs",
    "check:live": "node scripts/live-check.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "webExt": {
    "ignoreFiles": [
      "docs",
      "test",
      "scripts",
      "store",
      "test-results",
      "playwright-report",
      "playwright.config.js",
      "package.json",
      "package-lock.json",
      "README.md"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "web-ext": "^10.8.0"
  }
}
